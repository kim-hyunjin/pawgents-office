{
  "name": "pawgents-office",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "description": "Watch Claude Code sessions work as cats in a pixel-art office",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "start": "bun server/index.ts",
    "demo": "bun scripts/demo.ts --loop",
    "install-hooks": "bun hooks/install.ts",
    "uninstall-hooks": "bun hooks/uninstall.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "bun test test/"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
